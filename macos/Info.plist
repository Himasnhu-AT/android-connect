<plist version="1.0">
<dict>
	<!-- Custom keys merged into the generated Info.plist (GENERATE_INFOPLIST_FILE=YES uses this as base). -->

	<!-- macOS 15+ prompts for local-network access on first mDNS/Bonjour use. -->
